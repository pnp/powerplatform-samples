---
import { ArrowUpRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { sitePath } from '../lib/catalog';
import data from '../generated/legacy.json';
import { LEGACY_REPOSITORIES } from '../../scripts/publication-model.mjs';
interface LegacySample { title: string; description: string; sourceUrl: string; repository: string; }
const samples: LegacySample[] = data.samples;
---
<BaseLayout title="Legacy sample collections" description="Find older Power Apps, Power Automate, and Power Fx examples while community samples move to this repository.">
  <PageHero eyebrow="Keep your starting points within reach" title="More ideas. A little history." description="Older product repositories still contain useful community examples. These links remain available while migration is assessed; their original README and compatibility requirements still apply.">
    <a class="button button--primary" href={sitePath('/#sample-catalog')}>Explore the current gallery <ArrowUpRight size={16} /></a>
  </PageHero>
  <section class="container content-section">
    <p class="notice">Power Virtual Agents samples have moved to Copilot Studio, and that legacy repository is already archived. Archiving preserves source links but makes a repository read-only.</p>
    {samples.length === 0 && <p>This local build does not fetch external samples. The published site also preserves the historical catalog and refreshes the product metadata feeds.</p>}
    {LEGACY_REPOSITORIES.map((source) => <section class="content-section" id={source.slug}>
      <div class="section-heading"><div><p class="eyebrow">Legacy collection</p><h2>{source.title}</h2></div><a class="text-link" href={`https://github.com/${source.repository}`}>Visit the original repository <ArrowUpRight size={16} /></a></div>
      <div class="resource-grid">{samples.filter((sample) => sample.repository === source.repository).map((sample) => <article class="resource-card">
        <h3><a href={sample.sourceUrl}>{sample.title}</a></h3><p>{sample.description}</p><a class="text-link" href={sample.sourceUrl}>Read the original sample <ArrowUpRight size={15} /></a>
      </article>)}</div>
    </section>)}
    <p><a href={sitePath('/samples.json')}>Download the compatible sample catalog JSON</a>.</p>
    {data.excludedEntries.length > 0 && <p class="notice">{data.excludedEntries.length} non-sample legacy export entries were excluded from sample discovery. The <a href={sitePath('/legacy-catalog-original.json')}>original snapshot</a> and <a href={sitePath('/legacy-catalog-report.json')}>cleanup report</a> remain available.</p>}
  </section>
</BaseLayout>
