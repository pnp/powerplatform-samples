---
import { ArrowLeft, ArrowUpRight, CalendarDays, Download, ExternalLink } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { catalog, formatDate, sitePath, type Sample } from '../../lib/catalog';
import ProductMarks from '../../components/ProductMarks.astro';
import { communityLinks } from '../../lib/community';
export function getStaticPaths() {
  return catalog.samples.map((sample) => ({ params: { slug: sample.slug }, props: { sample } }));
}
interface Props { sample: Sample; }
const { sample } = Astro.props;
---
<BaseLayout title={sample.title} description={sample.shortDescription} image={sample.preview.src960}>
  <div class="container breadcrumb"><a href={sitePath('/#sample-catalog')}><ArrowLeft size={15} /> Back to all samples</a></div>
  <section class="container detail-hero">
    <div>
      <p class="eyebrow">A community-built Power Platform sample</p>
      <h1>{sample.title}</h1>
      <p class="detail-summary">{sample.shortDescription}</p>
      <ProductMarks products={sample.products} />
      <div class="action-row"><a class="button button--primary" href={sample.downloadUrl}><Download size={18} /> Download sample</a><a class="button button--secondary" href={sample.sourceUrl}>View source <ExternalLink size={16} /></a></div>
      <div class="detail-authors">{sample.authors.map((author) => <a href={`https://github.com/${author.gitHubAccount}`}>{author.name} <ArrowUpRight size={13} /></a>)}</div>
    </div>
    <figure class="detail-preview"><img src={sitePath(sample.preview.src960)} alt={sample.preview.alt} width={sample.preview.width} height={sample.preview.height} /></figure>
  </section>
  <section class="facts-band" aria-label="Sample facts"><dl class="container sample-facts">
    <div><dt>Last updated</dt><dd>{formatDate(sample.updatedAt)}</dd></div>
    <div><dt>Category</dt><dd>{sample.categories.join(', ') || 'Community sample'}</dd></div>
    {sample.premium && <div><dt>Premium license</dt><dd>{sample.premium}</dd></div>}
    {sample.experimental && <div><dt>Experimental features</dt><dd>{sample.experimental}</dd></div>}
  </dl></section>
  {sample.gallery.length > 1 && <section class="container content-section"><div class="section-heading"><div><p class="eyebrow">A closer look</p><h2>See the sample in action.</h2></div></div><div class="media-gallery">{sample.gallery.map((image) => <a href={sitePath(image.src)} aria-label={`Open image: ${image.alt}`}><img src={sitePath(image.src)} alt={image.alt} loading="lazy" decoding="async" /></a>)}</div></section>}
  <section class="container content-section detail-content">
    <div>
      <p class="eyebrow">From idea to implementation</p><h2>Make it your own.</h2>
      <p class="notice">Check this sample's prerequisites, permissions, and licensing before importing it. The documentation below comes directly from the sample README.</p>
      <div class="readme-content" set:html={sample.readmeHtml} />
    </div>
    <aside class="detail-sidebar">
      <h2>Useful links</h2>
      <nav class="stacked-links" aria-label="Sample resources">
        <a href={communityLinks.forums}>Ask the Power Platform Community <ArrowUpRight size={14} /></a>
        <a href={sample.sourceUrl}>README on GitHub <ArrowUpRight size={14} /></a>
        <a href={sitePath('/getting-started/')}>Using the samples</a>
        <a href="https://github.com/pnp/powerplatform-samples/issues/new/choose">Report a sample issue</a>
        {sample.references.map((reference) => <a href={reference.url}>{reference.name} <ArrowUpRight size={13} /></a>)}
      </nav>
      <hr />
      <CalendarDays size={23} /><h2>Keep learning together.</h2><p>Get fresh ideas and connect with other makers at our community calls.</p><a class="text-link" href="https://aka.ms/community/calls">Find your next call <ArrowUpRight size={14} /></a>
    </aside>
  </section>
</BaseLayout>
