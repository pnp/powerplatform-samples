---
import { ArrowUpRight, CalendarDays, HeartHandshake, Mic } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { sitePath } from '../lib/catalog';
---
<BaseLayout title="Community" description="Join Microsoft 365 and Power Platform community calls, share a demo, and connect with other makers.">
  <PageHero eyebrow="Everyone is welcome" title="Your community. Your next connection." description="Come with a question. Leave with an idea. Connect with the people building, learning, and sharing across Copilot, Microsoft 365, and Power Platform."><a class="button button--primary" href="https://aka.ms/community/calls"><CalendarDays size={18} /> Join the community calls</a></PageHero>
  <section class="container content-section">
    <div class="section-heading"><div><p class="eyebrow">Come as you are</p><h2>Let's learn something together.</h2></div></div>
    <div class="resource-grid">
      <article class="resource-card"><CalendarDays size={30} /><h2>Find your next call.</h2><p>See real solutions, hear from the people building them, and ask questions. Browse the community call schedule and download recurring invites so you don't miss a session.</p><a class="text-link" href="https://aka.ms/community/calls">Call schedule &amp; invites <ArrowUpRight size={16} /></a></article>
      <article class="resource-card"><Mic size={30} /><h2>Share what you've built.</h2><p>A community demo is a great way to share a technique, show a sample, and get feedback. Your experience could be exactly the spark another maker needs.</p><a class="text-link" href="https://aka.ms/community/request/demo">Sign up to present a demo <ArrowUpRight size={16} /></a></article>
      <article class="resource-card"><HeartHandshake size={30} /><h2>Find your people.</h2><p>Explore the Microsoft 365 &amp; Power Platform Community, discover learning opportunities, and learn how contributions are recognized.</p><a class="text-link" href="https://aka.ms/community/home">Visit community home <ArrowUpRight size={16} /></a></article>
    </div>
  </section>
  <section class="content-section content-section--soft"><div class="container two-columns">
    <div><p class="eyebrow">Small contributions. Real impact.</p><h2>There's a place for you here.</h2><p>You can share a sample, improve documentation, report a reproducible issue, or help someone understand a solution. You don't need to know everything to help someone take their next step.</p><a class="text-link" href={sitePath('/contributing/')}>Explore ways to contribute <ArrowUpRight size={16} /></a></div>
    <div><p class="eyebrow">Built on kindness</p><h2>Sharing is caring.</h2><p>Our community follows the Microsoft Open Source Code of Conduct. Be respectful, inclusive, and patient with others. We learn more when everyone feels welcome.</p><nav class="stacked-links"><a class="text-link" href="https://opensource.microsoft.com/codeofconduct/">Read the code of conduct <ArrowUpRight size={16} /></a><a class="text-link" href="https://aka.ms/community/recognition">Community recognition <ArrowUpRight size={16} /></a></nav></div>
  </div></section>
</BaseLayout>
