---
import { ArrowUpRight, GitFork, Menu, Moon, Sun } from '@lucide/astro';
import { brandPath, sitePath } from '../lib/catalog';
import { visitorStatsUrl } from '../../scripts/gallery-model.mjs';
import { communityLinks } from '../lib/community';
import '../styles/global.css';

interface Props { title?: string; description?: string; image?: string; }
const {
  title = 'Power Platform sample gallery',
  description = 'Discover community-built Power Platform samples. Explore apps, automations, agents, and solutions. Learn something new. Share what you build.',
  image = 'generated/brand/portrait-1-800.webp',
} = Astro.props;
const pageTitle = title === 'Power Platform sample gallery' ? title : `${title} | Power Platform sample gallery`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const navigation = [
  ['Samples', '/'], ['Getting started', '/getting-started/'], ['Contributors', '/contributors/'],
  ['Contributing', '/contributing/'], ["What's new", '/whats-new/'], ['Community', '/community/'],
];
const current = (href: string) => href === '/'
  ? Astro.url.pathname === sitePath('/') || Astro.url.pathname.startsWith(sitePath('/samples/'))
  : Astro.url.pathname.startsWith(sitePath(href));
const backgrounds = [
  `--mesh-light: url("${brandPath('mesh-light-teal.webp')}")`,
  `--mesh-dark: url("${brandPath('mesh-dark-teal.webp')}")`,
  `--mesh-blue: url("${brandPath('mesh-light-blue.webp')}")`,
  `--mesh-blue-dark: url("${brandPath('mesh-dark-blue.webp')}")`,
  `--ribbon-blue: url("${brandPath('ribbon-blue.webp')}")`,
  `--ribbon-magenta: url("${brandPath('ribbon-magenta.webp')}")`,
].join(';');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7faf9" id="theme-color" />
    <script is:inline>
      (() => {
        document.documentElement.classList.add('js-enabled');
        let theme = 'light';
        try {
          const stored = localStorage.getItem('power-platform-gallery-theme');
          if (stored === 'light' || stored === 'dark') theme = stored;
        } catch (error) {
          console.warn('Theme preferences are unavailable in this browser.', error);
        }
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
    <title>{pageTitle}</title>
    <link rel="icon" type="image/png" href={brandPath('powerplatform_256x256.png')} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(sitePath(image), Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body style={backgrounds}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="product-spectrum" aria-hidden="true"></div>
      <div class="header-inner container">
        <a class="brand" href={sitePath('/')}>
          <img src={brandPath('powerplatform_256x256.png')} alt="" width="42" height="42" />
          <span><strong>Power Platform</strong> <span>sample gallery</span></span>
        </a>
        <nav class="desktop-nav" aria-label="Primary navigation">
          {navigation.map(([label, href]) => <a href={sitePath(href)} aria-current={current(href) ? 'page' : undefined}>{label}</a>)}
        </nav>
        <div class="header-actions">
          <a class="github-link" href="https://github.com/pnp/powerplatform-samples" aria-label="Power Platform samples on GitHub"><GitFork size={19} /><span>GitHub</span></a>
          <button class="theme-toggle js-only" id="theme-toggle" role="switch" aria-checked="false" aria-label="Switch to dark mode" title="Switch to dark mode">
            <Sun class="sun-icon" size={18} /><Moon class="moon-icon" size={18} />
          </button>
          <details class="mobile-menu">
            <summary aria-label="Open navigation"><Menu size={23} /></summary>
            <nav aria-label="Mobile navigation">
              {navigation.map(([label, href]) => <a href={sitePath(href)} aria-current={current(href) ? 'page' : undefined}>{label}</a>)}
              <a href="https://github.com/pnp/powerplatform-samples">GitHub</a>
            </nav>
          </details>
        </div>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-top">
        <div>
          <a class="footer-brand" href="https://aka.ms/community/home">Microsoft 365 &amp; Power Platform Community <ArrowUpRight size={17} /></a>
          <p>Built by the community. Shared with everyone.</p>
          <span class="footer-motto">Sharing is caring.</span>
        </div>
        <nav aria-label="Footer navigation">
          <a href={communityLinks.forums}>Community forums</a>
          <a href={communityLinks.calls}>Community calls</a>
          <a href={sitePath('/contributing/')}>Contribute a sample</a>
          <a href={communityLinks.recordings}>Community recordings</a>
          <a href={communityLinks.powerPlatformVideos}>Power Platform videos</a>
          <a href={sitePath('/catalog.json')}>Catalog JSON</a>
          <a href={sitePath('/legacy-samples/')}>Legacy sample collections</a>
          <a href="https://github.com/pnp/powerplatform-samples/issues/new/choose">Report an issue</a>
          <a href="https://opensource.microsoft.com/codeofconduct/">Code of conduct</a>
          <a href="https://github.com/pnp/powerplatform-samples/blob/main/LICENSE">MIT license</a>
        </nav>
      </div>
      <div class="container footer-bottom"><span>Community samples, provided as is. Check each sample's requirements before use.</span><a href="https://learn.microsoft.com/power-platform/">Power Platform documentation <ArrowUpRight size={14} /></a></div>
    </footer>
    {import.meta.env.PROD && <img data-visitor-stats data-src={visitorStatsUrl(Astro.url.pathname)} width="1" height="1" alt="" aria-hidden="true" class="visitor-pixel" />}
    <script>
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
      const themeColor = document.querySelector<HTMLMetaElement>('#theme-color');
      function applyTheme(theme: 'light' | 'dark') {
        root.dataset.theme = theme;
        root.style.colorScheme = theme;
        const dark = theme === 'dark';
        toggle?.setAttribute('aria-checked', String(dark));
        toggle?.setAttribute('aria-label', `Switch to ${dark ? 'light' : 'dark'} mode`);
        if (toggle) toggle.title = `Switch to ${dark ? 'light' : 'dark'} mode`;
        if (themeColor) themeColor.content = dark ? '#0e1918' : '#f7faf9';
      }
      applyTheme(root.dataset.theme === 'dark' ? 'dark' : 'light');
      toggle?.addEventListener('click', () => {
        const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        applyTheme(theme);
        try {
          localStorage.setItem('power-platform-gallery-theme', theme);
        } catch (error) {
          console.warn('Your theme selection could not be saved.', error);
        }
      });
      const pixel = document.querySelector<HTMLImageElement>('img[data-visitor-stats]');
      if (pixel?.dataset.src && !['localhost', '127.0.0.1', '[::1]', '::1'].includes(window.location.hostname)) {
        pixel.src = pixel.dataset.src;
      }
    </script>
  </body>
</html>
