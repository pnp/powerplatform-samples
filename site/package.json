{
  "name": "power-platform-sample-gallery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "generate": "node scripts/generate-gallery.mjs",
    "validate:readme-trackers": "node scripts/validate-readme-trackers.mjs",
    "validate:links": "node scripts/validate-build.mjs",
    "dev": "npm run generate && astro dev --host 127.0.0.1",
    "start": "npm run dev",
    "check": "npm run generate && astro check",
    "build": "npm run generate && astro build && node scripts/publication.mjs mark",
    "build:publication": "npm run generate && node scripts/publication.mjs prepare && astro build && node scripts/publication.mjs mark",
    "deployment:verify": "node scripts/publication.mjs verify",
    "preview": "astro preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@lucide/astro": "^1.57.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "astro": "~7.3.8",
    "marked": "^18.1.1",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.19.0",
    "@types/sanitize-html": "^2.16.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
